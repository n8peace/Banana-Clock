<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>bananaclock.bananaintelligence.ai</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bananaclock</string>
			</array>
		</dict>
	</array>
	<key>MinimumOSVersion</key>
	<string>26.0</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>Banana Clock creates personalized AI wake-up experiences that work reliably even when your phone is backgrounded or turned off, just like native alarms.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Banana Clock uses your location to provide accurate weather updates and local news in your personalized wake-up content.</string>
	<key>NSLocationUsageDescription</key>
	<string>Banana Clock uses your location to provide accurate weather updates and local news in your personalized wake-up content.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>supabase.co</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>REVENUECAT_API_KEY</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>background-processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>bananaclock.content-generation</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<false/>
</dict>
</plist>
